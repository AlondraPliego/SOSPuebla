# Copia este archivo como deploy/sos.env, cambia los valores y súbelo al servidor con scp.
# deploy/sos.env NO se sube a GitHub (está en .gitignore): tiene contraseñas.

# Usuario y contraseña de la base de datos que creará setup-servidor.sh
DB_USUARIO=sos
DB_PASSWORD=cambia-esta-contraseña

# Secreto para firmar las sesiones (JWT): al menos 32 caracteres al azar
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-32+
