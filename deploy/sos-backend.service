[Unit]
Description=SOS Puebla - backend (Spring Boot)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
User=sos
Group=sos
WorkingDirectory=/opt/sos
EnvironmentFile=/opt/sos/backend.env
# 512 MB de heap: suficiente para la demo y deja memoria a MariaDB en instancias chicas
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/sos/sos.jar --server.port=8080 --server.address=127.0.0.1
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
