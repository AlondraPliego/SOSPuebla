# Copia este archivo como .env si el backend no corre en http://localhost:8080
VITE_API_URL=http://localhost:8080
# Opcional: por defecto se usa ws://<host del API>/ws
# VITE_WS_URL=ws://localhost:8080/ws

# --- Prueba del dije desde el teléfono (Web Bluetooth exige https://) ---
# Usa el proxy de Vite para que app y backend salgan por la misma dirección:
#   VITE_API_URL=/api
# y expón el puerto de Vite con un túnel HTTPS (ver DIJE.md).
